  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs before every request: stop early if a variable the request needs is still empty.",
          "var needed = ['base_url', 'api_token'];",
          "if (pm.request.method === 'POST') {",
          "  needed.push('payer_phone', 'callback_url');",
          "}",
          "var missing = needed.filter(function (name) { return !pm.variables.get(name); });",
          "if (missing.length) {",
          "  throw new Error('Fill in ' + missing.join(', ') + ' in the collection Variables tab first.');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://palmpesa.co.tz",
      "type": "string",
      "description": "PalmPesa API base URL."
    },
    {
      "key": "api_token",
      "value": "",
      "type": "string",
      "description": "Your API token from the PalmPesa dashboard. Keep it private."
    },
