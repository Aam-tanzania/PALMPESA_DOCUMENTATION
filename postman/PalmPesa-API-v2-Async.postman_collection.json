          "cookie": [],
          "body": "{\n  \"success\": true,\n  \"data\": {\n    \"transaction_id\": \"ORDER-2026-000123\",\n    \"order_id\": \"PALMPESAV2A20261008120000123EFGH5678\",\n    \"status\": \"INITIATION_FAILED\",\n    \"failure_reason\": \"PROVIDER_UNAVAILABLE\",\n    \"amount\": 1000,\n    \"currency\": \"TZS\",\n    \"reference\": null,\n    \"channel\": null,\n    \"created_at\": \"2026-10-08 12:00:00\",\n    \"updated_at\": \"2026-10-08 12:00:02\",\n    \"status_url\": \"https://palmpesa.co.tz/api/v2/async/payments/PALMPESAV2A20261008120000123EFGH5678\"\n  }\n}"
        },
        {
          "name": "404 Not found",
          "status": "Not Found",
          "code": 404,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "cookie": [],
          "body": "{\n  \"message\": \"Payment not found.\",\n  \"order_id\": \"PALMPESAV2A20261008120000123EFGH5678\"\n}"
        }
      ]
    },
    {
      "name": "Request payment - identical retry (same transaction_id)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Reuses the transaction_id of the last \"Request payment\" send.",
              "if (!pm.collectionVariables.get('transaction_id')) {",
              "  throw new Error('Send \"Request payment\" first; this request repeats it with the same transaction_id.');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('202 Accepted', function () { pm.response.to.have.status(202); });",
              "pm.test('returns the original order_id', function () {",
              "  pm.expect(pm.response.json().data.order_id).to.eql(pm.collectionVariables.get('order_id'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v2/async/payments",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v2",
            "async",
            "payments"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"transaction_id\": \"{{transaction_id}}\",\n  \"amount\": {{amount}},\n  \"currency\": \"TZS\",\n  \"phone\": \"{{payer_phone}}\",\n  \"name\": \"{{payer_name}}\",\n  \"email\": \"{{payer_email}}\",\n  \"callback_url\": \"{{callback_url}}\",\n  \"buyer_remarks\": \"Postman test payment\",\n  \"merchant_remarks\": \"Postman test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Repeats the last **Request payment** with the same `transaction_id` and details, as you would after a timeout. PalmPesa returns the original payment and its current status; the customer is not prompted again. Changing any detail (for example `amount`) returns `409`."
      },
      "response": [
        {
          "name": "202 Same payment, current status",
          "status": "Accepted",
          "code": 202,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "cookie": [],
          "body": "{\n  \"success\": true,\n  \"message\": \"Payment accepted.\",\n  \"data\": {\n    \"transaction_id\": \"ORDER-2026-000123\",\n    \"order_id\": \"PALMPESAV2A20261008120000123EFGH5678\",\n    \"status\": \"PENDING\",\n    \"failure_reason\": null,\n    \"amount\": 1000,\n    \"currency\": \"TZS\",\n    \"reference\": \"0289999288\",\n    \"channel\": null,\n    \"created_at\": \"2026-10-08 12:00:00\",\n    \"updated_at\": \"2026-10-08 12:00:03\",\n    \"status_url\": \"https://palmpesa.co.tz/api/v2/async/payments/PALMPESAV2A20261008120000123EFGH5678\"\n  }\n}"
        }
      ]
    },
    {
